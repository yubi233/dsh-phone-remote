{
  "name": "dsh-phone-remote",
  "version": "0.2.2",
  "type": "module",
  "description": "DSH Host side of dsh-web-remote: relay transport, pairing, RPC bridge, stream replay, and the web GUI console",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build": "tsx scripts/build.ts"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.4"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "shell",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dsh-web-remote/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "@dsh-web-remote/relay": "workspace:*",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}